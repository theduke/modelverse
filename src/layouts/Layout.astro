---
import '../styles/global.css';

const { title = 'Modelverse' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav class="nav">
			<a href="/" class="nav-link" class:list={{ active: Astro.url.pathname === '/' }}>Home</a>
			<a href="/compare" class="nav-link" class:list={{ active: Astro.url.pathname === '/compare' }}>Compare Models</a>
			<a href="/sources" class="nav-link" class:list={{ active: Astro.url.pathname === '/sources' }}>Sources</a>
		</nav>
		<slot />
	</body>
</html>
